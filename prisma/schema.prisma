generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  ACTIVE
  REPLIED
  RESPONDED_BACK
  FAILED
  STOPPED
  BOUNCED
}

enum EmailLogStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  contacts    Contact[]
  companies   Company[]
  templates   Template[]
  campaigns   Campaign[]
  preferences Preferences?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Campaign {
  id        String             @id @default(cuid())
  title     String
  userId    String
  contacts  Contact[]
  templates CampaignTemplate[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  emailLogs EmailLog[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id        String    @id @default(cuid())
  name      String
  userId    String
  contacts  Contact[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Contact {
  id         String     @id @default(cuid())
  name       String
  email      String
  userId     String
  companyId  String
  campaignId String
  status     Status     @default(ACTIVE)
  emailLogs  EmailLog[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Template {
  id          String             @id @default(cuid())
  name        String
  subject     String
  body        String
  attachments String[]
  userId      String
  campaigns   CampaignTemplate[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailLogs   EmailLog[]
}

model CampaignTemplate {
  id         String   @id @default(cuid())
  campaignId String
  templateId String
  sequence   Int
  delay      Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([campaignId, templateId])
}

model Preferences {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  stopAllCompanyMailsOnReply Boolean  @default(true)
  timezone                   String   @default("UTC")
  mailSendingTime            String   @default("09:00")
  sendOnWeekends             Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id           String         @id @default(cuid())
  campaignId   String
  templateId   String
  contactId    String
  status       EmailLogStatus @default(SCHEDULED)
  scheduledAt  DateTime?
  sentAt       DateTime?
  errorMessage String?
  retryCount   Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
}
